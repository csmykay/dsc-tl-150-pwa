# TL-150 panel
DSC_HOST=192.168.1.10
DSC_USER=admin
DSC_PASS=
DSC_PIN=

# Optional: app title shown in the browser and header (default: Home Security)
# APP_TITLE=My Home Security

# Optional: poll interval in seconds (default 10)
# POLL_SECS=10

# Optional: zones to display — whole count (8, 16, 32) or list with ranges, e.g. 1-8,10,12,14 (default 16)
# ZONE_LIMIT=16
