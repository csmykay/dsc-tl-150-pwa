# TL-150 panel (copy to .env and fill in)
DSC_HOST=192.168.1.10
DSC_USER=admin
DSC_PASS=
DSC_PIN=

# Optional: app title (browser/header) and short name (PWA home screen)
# APP_TITLE=My Home Security
# APP_SHORT_NAME=My Home

# Optional: poll interval in seconds (default 10)
# POLL_SECS=10

# Optional: number of zones to display — 8, 16, or 32 (default 16)
# ZONE_LIMIT=16
